# Local: copy to .env.local. Production: set in Vercel > Settings > Environment Variables, then redeploy.

# Required. YouTube Data API v3 key (Google Cloud > APIs & Services > Credentials). Secret: never commit.
YOUTUBE_API_KEY=

# Optional. Site address for canonical/share links. Empty = https://getplaypace.vercel.app
SITE_URL=

# Optional. Google Analytics ID, e.g. G-XXXXXXXXXX (Analytics > Admin > Data streams). Public.
GA_MEASUREMENT_ID=

# Optional. Search Console "HTML tag" code: only the part inside content="...". Public.
GOOGLE_SITE_VERIFICATION=

# Tests/dev only. 1 = fake sample playlists instead of YouTube (no key needed). Never set in production.
PLAYPACE_SAMPLE_DATA=
