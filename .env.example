# Required in production: a YouTube Data API v3 key (Google Cloud console > APIs & Services > Credentials).
# Restrict it to the YouTube Data API v3. It is only used on the server and never sent to the browser.
YOUTUBE_API_KEY=

# Optional: the public address of the site (used for canonical links, sitemap and share links).
# Defaults to https://getplaypace.vercel.app
SITE_URL=

# Optional: Google Analytics 4 measurement ID, e.g. G-XXXXXXXXXX. Analytics loads only when this is set.
GA_MEASUREMENT_ID=

# Optional: the content value of the Google Search Console HTML tag.
GOOGLE_SITE_VERIFICATION=

# Development and tests: 1 serves built-in sample playlists instead of calling YouTube.
PLAYPACE_SAMPLE_DATA=
