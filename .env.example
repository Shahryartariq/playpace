# Copy this file to .env.local for local development. In production, set these in
# Vercel > Project > Settings > Environment Variables, then redeploy.

# YOUTUBE_API_KEY (required in production)
# Lets Playpace read playlists, channels and videos from YouTube.
# Get it from: Google Cloud console > APIs & Services > Credentials > Create credentials > API key.
# Restrict the key to "YouTube Data API v3". It stays on the server and is never sent to the browser.
# Keep it secret: don't commit it, paste it in chat or put it in screenshots.
YOUTUBE_API_KEY=

# SITE_URL (optional, usually leave empty)
# The site's public address, used in canonical links, the sitemap and share links.
# Empty means https://getplaypace.vercel.app. Only set it if the site moves to another domain.
SITE_URL=

# GA_MEASUREMENT_ID (optional)
# Google Analytics 4 ID, looks like G-XXXXXXXXXX.
# Get it from: Google Analytics > Admin > Data streams > your web stream > Measurement ID.
# Analytics only loads when this is set. Not a secret: it appears in the page's HTML.
GA_MEASUREMENT_ID=

# GOOGLE_SITE_VERIFICATION (optional)
# Proves to Google Search Console that you own the site.
# Get it from: Search Console > Add property > URL prefix > Verify ownership > "HTML tag".
# Copy only the code inside content="..." from the meta tag. Not a secret: it appears in the page's HTML.
# After deploying with it set, click Verify in Search Console.
GOOGLE_SITE_VERIFICATION=

# PLAYPACE_SAMPLE_DATA (development and tests only; never set it in production)
# 1 = don't call YouTube; show built-in fake playlists instead. Used by the automated tests
#     (same results every run, no YouTube quota used) and to try the site without an API key.
# Empty = normal mode: real playlists from YouTube using YOUTUBE_API_KEY.
# If this were 1 in production, every visitor would see fake results.
PLAYPACE_SAMPLE_DATA=
